RewriteEngine On
RewriteRule ^api/auth/(.+)$ api/auth.php?action=$1 [QSA,L]
RewriteRule ^api/feed$ api/feed.php [QSA,L]
RewriteRule ^api/property/([0-9]+)$ api/property.php?id=$1 [QSA,L]
RewriteRule ^api/property$ api/property.php [QSA,L]
RewriteRule ^api/like/([0-9]+)$ api/like.php?id=$1 [QSA,L]
RewriteRule ^api/comment/([0-9]+)$ api/comment.php?id=$1 [QSA,L]
RewriteRule ^api/follow/([0-9]+)$ api/follow.php?id=$1 [QSA,L]
RewriteRule ^api/save/([0-9]+)$ api/save.php?id=$1 [QSA,L]
RewriteRule ^api/upload$ api/upload.php [QSA,L]
RewriteRule ^api/profile/([0-9]+)$ api/profile.php?id=$1 [QSA,L]
RewriteRule ^api/search$ api/search.php [QSA,L]
RewriteRule ^api/notifications$ api/notifications.php [QSA,L]
